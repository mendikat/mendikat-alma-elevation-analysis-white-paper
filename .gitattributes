# Normalize line endings: store and check out text files with LF
* text=auto eol=lf

# Text sources
*.md    text eol=lf
*.tex   text eol=lf
*.bib   text eol=lf
*.sty   text eol=lf
*.cls   text eol=lf

# Binary files (no line-ending conversion, no text diff)
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.eps   binary
